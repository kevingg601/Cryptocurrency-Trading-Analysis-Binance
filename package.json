{
  "name": "fadachi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview",
    "desktop:start": "electron main.cjs",
    "desktop:build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.antigravity.crypto",
    "productName": "AntigravityCrypto",
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "target": "portable"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "package.json"
    ]
  },
  "dependencies": {
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
