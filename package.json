{
  "name": "fadachi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "main.cjs",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n collector,web \"npm run dev -w apps/collector\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w packages/core && npm run build -w apps/collector && npm run build -w apps/web",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test packages/core/test/*.test.ts apps/collector/test/*.test.ts apps/web/test/*.test.ts apps/desktop/test/*.test.cjs",
    "test:core": "node --experimental-strip-types --test packages/core/test/*.test.ts",
    "test:collector": "node --experimental-strip-types --test apps/collector/test/*.test.ts",
    "preview": "vite preview",
    "desktop:start": "npm run start -w apps/desktop",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-ai-ab.ps1"
  },
  "build": {
    "appId": "com.antigravity.crypto",
    "productName": "AntigravityCrypto",
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "target": "portable"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "package.json"
    ]
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/websocket": "^11.3.4",
    "concurrently": "^10.0.6",
    "duckdb": "^1.4.4",
    "fastify": "^5.12.7",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "ws": "^8.22.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
