{
  "name": "@fadachi/core",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./market/*": "./src/market/*.ts",
    "./alerts/*": "./src/alerts/*.ts",
    "./follow/*": "./src/follow/*.ts",
    "./auto/*": "./src/auto/*.ts",
    "./backtest/*": "./src/backtest/*.ts",
    "./orders/*": "./src/orders/*.ts",
    "./indicators/*": "./src/indicators/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  }
}
