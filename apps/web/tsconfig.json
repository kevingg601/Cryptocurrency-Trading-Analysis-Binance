{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "jsx": "react-jsx"
  },
  "include": ["src", "src/vite-env.d.ts"]
}
